{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "CostPerPrompt"
  },
  "author": "Karmendra Pandey",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "pricing.js",
        "tokenizer.js",
        "content.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "See what your AI chats actually cost. Live token and cost estimates on ChatGPT, Claude, and Gemini, across 9 models.",
  "homepage_url": "https://github.com/karmendra8386/agentic-ai-token-economics",
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "CostPerPrompt \u2014 AI Chat Cost Tracker",
  "options_page": "options/options.html",
  "permissions": [
    "storage"
  ],
  "short_name": "CostPerPrompt",
  "version": "0.1.2"
}